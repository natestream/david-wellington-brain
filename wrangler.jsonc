{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "david-wellington-brain",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: required by the OAuth library to fetch Client ID Metadata Documents safely.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // D1: structured tables (doors, daily_kpis, notes).
  // database_id is left out on purpose: `wrangler deploy` and the
  // Deploy to Cloudflare button create the database on the account that deploys.
  // For your own account you can paste the id from `wrangler d1 create david-brain`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "david-brain",
      "migrations_dir": "migrations"
    }
  ],

  // Vectorize: semantic search over doors and notes.
  // Must be 768 dimensions, cosine (matches @cf/baai/bge-base-en-v1.5).
  // dimensions + metric are for the Deploy to Cloudflare button, which creates the index.
  // Wrangler 4.157/4.158 warns "Unexpected fields" about them; that warning is harmless.
  // `remote: true` makes `wrangler dev` use the real index (it can't run locally).
  "vectorize": [
    {
      "binding": "VECTORS",
      "index_name": "david-brain-notes",
      "dimensions": 768,
      "metric": "cosine",
      "remote": true
    }
  ],

  // KV for Google sign-in (OAuth clients, grants, tokens; hashed/encrypted by the library).
  // No id on purpose: the deploy creates the namespace on the account that deploys, like D1.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],

  // Workers AI: embeddings only. No other model is called by the server.
  "ai": { "binding": "AI", "remote": true },

  // Secret (not in this file): DOPPLER_TOKEN. Every other secret is read from Doppler at runtime.

  // The settings above are STAGING (Nate's testing, `wrangler deploy` with no --env).
  // PRODUCTION is David's brain, on the same Cloudflare account but fully separate:
  // its own Worker, database, search index and sign-in store. Deployed with `--env production`,
  // only after Nate approves the deploy in GitHub Actions.
  // Bindings aren't inherited by environments, so they're repeated here with production names.
  "env": {
    "production": {
      "name": "david-brain",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "david-brain-prod",
          "migrations_dir": "migrations"
        }
      ],
      "vectorize": [
        {
          "binding": "VECTORS",
          "index_name": "david-brain-notes-prod",
          "dimensions": 768,
          "metric": "cosine",
          "remote": true
        }
      ],
      "kv_namespaces": [{ "binding": "OAUTH_KV" }],
      "ai": { "binding": "AI", "remote": true }
    }
  }
}
